<Window x:Name="Email1" x:Class="SubsrciptionSystem.Email"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SubsrciptionSystem"
        mc:Ignorable="d"
        Title="Email" 
        Height="800"
        Width="800"
        WindowStartupLocation="CenterOwner">


    <Grid>
        <Border Width="320"
                Padding="25"
                CornerRadius="14"
                Background="White"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">

            <StackPanel>

                <!-- Header -->
                <TextBlock Text="Email User"
                           FontSize="20"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>

                <TextBlock Text="Enter your details"
                           FontSize="12"
                           Foreground="Gray"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>
                
                <TextBlock Text="First Name" FontSize="12"/>
                <TextBox x:Name="txtFName"
                         Height="36"
                         Margin="0,6,0,14"
                         Padding="10"/>


                <TextBlock Text="Last Name" FontSize="12"/>
                <TextBox x:Name="txtLName"
                         Height="36"
                         Margin="0,6,0,14"
                         Padding="10"/>

                <TextBlock Text="Email Address" FontSize="12"/>
                <TextBox x:Name="txtEmail"
                         Height="39"
                         Margin="0,6,0,14"
                         Padding="10"/>

                <TextBlock Text="Company" FontSize="12"/>
                <TextBox x:Name="txtcompany"
                         Height="36"
                         Margin="0,6,0,14"
                         Padding="10"/>


                <TextBlock Text="Storage(GB)" FontSize="12"/>
                <TextBox x:Name="txtStorage"
                         Height="36"
                         Margin="0,6,0,14"
                         Padding="10"/>

                <TextBlock Text="Password" FontSize="12"/>
                <PasswordBox x:Name="txtpassword"
                         Height="36"
                         Margin="0,6,0,14"
                         Padding="10"/>

                <!-- Button -->
                <Button Content="SUBMIT"
                        Height="42"
                        Background="#4F46E5"
                        Foreground="White"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="Submit_Click"
                        />

            </StackPanel>
        </Border>
    </Grid>
</Window>
