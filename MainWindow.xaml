<Window x:Class="SubsrciptionSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SubsrciptionSystem"
        mc:Ignorable="d"
        Title="Subscription System" Height="450" Width="800" Icon="/Images/icons8-info-48.png"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <Border Background="White"
                CornerRadius="10"
                Padding="30"
                Margin="100"
                BorderBrush="#bdc3c7"
                BorderThickness="1"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="Gray" BlurRadius="10" ShadowDepth="3"/>
            </Border.Effect>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Exam Management System"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#2c3e50"
                           Margin="0,0,0,20"
                           TextAlignment="Center"/>

                <TextBlock Text="Welcome to the EMS Portal. This system allows you to manage students, batches, rooms, courses, and exam schedules with ease."
                           FontSize="14"
                           Foreground="#34495e"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,0,30"
                           Width="400"/>

                <Button Content="Get Started"
                        Width="150"
                        Height="40"
                        FontWeight="Bold"
                        Background="#3498db"
                        Foreground="White"
                        Cursor="Hand"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>
