<Window x:Class="SubsrciptionSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SubsrciptionSystem"
        mc:Ignorable="d"
        Title="Subscription System" 
        Height="500" Width="800" 
        Icon="/Images/icons8-info-48.png"
        WindowStartupLocation="CenterScreen">

        <DockPanel>
            <Label HorizontalContentAlignment="Center" Name="welcome" Content="Welcome To Subscription System" Background="Black" Foreground="White" Height="200"  DockPanel.Dock="Top" ></Label>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Services">
                <MenuItem Header="Email" Click="EmailMenu_Click"></MenuItem>

                <MenuItem Header="Domain" Click="DomainMenu_Click"></MenuItem>

                <MenuItem Header="Software" Click="SoftwareMenu_Click"></MenuItem>

            </MenuItem>
            <MenuItem Header="Email" Click="EmailMenu_Click"></MenuItem>

            <MenuItem Header="Domain" Click="DomainMenu_Click"></MenuItem>

            <MenuItem Header="Software" Click="SoftwareMenu_Click"></MenuItem>
        </Menu>
        </DockPanel>
</Window>
